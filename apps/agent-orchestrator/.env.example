# ── Demo mode ─────────────────────────────────────────────────────────────────
# Set to true to run the whole DS Accelerator flow (Improve component, Run QA)
# against fixture data instead of a real Storybook, Jira, GitHub, or AI
# provider — no credentials, no live design system, no network calls. Storybook
# shows one fixture component (Credit Score), Jira shows fixture tickets
# (including DS-042), the workspace repository points at a seeded scratch repo
# under apps/agent-orchestrator/.demo-repo/ instead of this checkout, and the
# provider picker gets a "Demo (offline)" option with canned responses. Every
# other setting below is ignored when this is on.
# DEMO_MODE=true

# ── Cursor provider ──────────────────────────────────────────────────────────
# When set, the Cursor provider registers automatically at startup.
# Omit (or leave as placeholder) to skip Cursor — the server still starts
# if another provider is configured.
CURSOR_API_KEY=cursor_xxx

# Optional: preferred Cursor model ID (auto-selected from account when omitted)
# CURSOR_MODEL=

# Load local Cursor settings + MCP servers (Figma, etc.)
CURSOR_LOCAL_SETTING_SOURCES=all

# Method 2 — Cursor CLI (personal subscription, this machine only):
# Registers automatically when the `cursor-agent` CLI is installed
# (https://cursor.com/cli). The run uses the Cursor sign-in stored on this
# machine (your personal plan). Per Cursor's terms, subscription usage is
# individual — do NOT use this method on a shared or hosted server; use an
# API key there instead.
# Set to false to disable auto-registration:
# CURSOR_CLI_ENABLED=true

# Optional: model ID for Cursor CLI runs (e.g. sonnet-4-thinking, gpt-5; defaults to the CLI's own "Auto" selection)
# CURSOR_CLI_MODEL=

# ── Claude provider (Anthropic) ───────────────────────────────────────────────
# Claude supports two authentication methods; both can be active at once and
# the user picks one per run in the playground.
#
# Method 1 — API key (central, billed per token):
# ANTHROPIC_API_KEY=sk-ant-xxx

# Optional: preferred Claude model ID (defaults to claude-sonnet-4-6)
# CLAUDE_MODEL=

# Optional: enable extended thinking (claude-sonnet-4-6 or later required)
# CLAUDE_EXTENDED_THINKING=false

# Method 2 — Claude Code (personal subscription, this machine only):
# Registers automatically when the `claude` CLI is installed. The run uses the
# Claude sign-in stored on this machine (Pro/Max plan). Per Anthropic's terms,
# subscription credits are individual — do NOT use this method on a shared or
# hosted server; use an API key there instead.
# Set to false to disable auto-registration:
# CLAUDE_CODE_ENABLED=true

# Optional: model ID for Claude Code runs (defaults to Claude Code's own default)
# CLAUDE_CODE_MODEL=

# Optional: permission mode for Claude Code runs. Default 'acceptEdits'
# (file edits auto-approved so implementation jobs work; Bash still denied).
# Valid: default | acceptEdits | bypassPermissions | plan | dontAsk | auto
# CLAUDE_CODE_PERMISSION_MODE=acceptEdits

# Optional — Figma MCP for Claude Code runs (reads real Figma frames, not just
# the pasted URL): Claude Code is an officially supported client for Figma's
# remote MCP server (developers.figma.com/docs/figma-mcp-server). The
# orchestrator declares the server automatically whenever a run includes a
# Figma source; nothing to configure here. Authentication is a ONE-TIME step
# you run yourself in a terminal on this machine (the server requires your own
# Figma OAuth sign-in — the orchestrator cannot complete this on your behalf):
#   claude mcp add --transport http figma https://mcp.figma.com/mcp --scope user
#   claude mcp login figma
# Until that's done, Figma-sourced runs will report that the Figma MCP server
# needs authentication instead of silently ignoring the link.

# ── OpenAI provider ──────────────────────────────────────────────────────────
# When set, the OpenAI provider registers automatically at startup.
# Omit to skip OpenAI — the server still starts if another provider is configured.
# OPENAI_API_KEY=sk-proj-xxx

# Optional: preferred OpenAI model ID (defaults to gpt-4o)
# OPENAI_MODEL=

# ── Gemini provider (Google) ──────────────────────────────────────────────────
# When set, the Gemini provider registers automatically at startup.
# Omit to skip Gemini — the server still starts if another provider is configured.
# GEMINI_API_KEY=AQ.xxx

# Optional: preferred Gemini model ID (defaults to gemini-2.0-flash)
# GEMINI_MODEL=

# ── Jira integration ───────────────────────────────────────────────────────────
# Real OAuth 2.0 (3LO) integration — not a mock. Requires an OAuth app
# registered in the Atlassian Developer Console (developer.atlassian.com/console/myapps):
#   1. Create an "OAuth 2.0 integration" app.
#   2. Add the "Jira API" permission with scopes: read:jira-work, read:jira-user, offline_access.
#   3. Under Authorization, set the callback URL to match JIRA_REDIRECT_URI below
#      (http://localhost:8787/api/integrations/jira/callback for local dev).
#   4. Copy the Client ID and Secret from the app's Settings tab into the two
#      variables below, then restart the assistant service.
# Each user connects their own Jira account from the Integrations page — this
# app registration is a one-time, admin-level setup step, not a per-user key.
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=

# Optional: override the OAuth callback URL (must exactly match the Atlassian app config)
# JIRA_REDIRECT_URI=http://localhost:8787/api/integrations/jira/callback

# Optional: where the browser should land after connecting/disconnecting Jira
# WEB_APP_ORIGIN=http://localhost:5173

# ── GitHub repository provider ──────────────────────────────────────────────────
# Real OAuth App integration — not a mock. Requires an OAuth App registered at
# github.com/settings/developers (or your org's equivalent):
#   1. "New OAuth App".
#   2. Homepage URL: http://localhost:5173 (or WEB_APP_ORIGIN below).
#   3. Authorization callback URL must match GITHUB_REDIRECT_URI below
#      (http://localhost:8787/api/integrations/github/callback for local dev).
#   4. Copy the Client ID, generate a Client Secret, and set both below, then
#      restart the assistant service.
# Each user connects their own GitHub account from Settings → Workspace — this
# app registration is a one-time, admin-level setup step, not a per-user key.
# Requested scopes: `repo` (push access, needed to clone/commit/push and open
# PRs — GitHub has no narrower scope that still covers private-repo push) and
# `read:org` (lists organizations in the repository picker).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional: override the OAuth callback URL (must exactly match the GitHub OAuth App config)
# GITHUB_REDIRECT_URI=http://localhost:8787/api/integrations/github/callback

# ── Jira Product Discovery ────────────────────────────────────────────────────
# "Send to Product Discovery" creates a real idea in this Product Discovery
# space when all four are set; without them, sending stays a demo. Uses your
# own Atlassian API token (https://id.atlassian.com/manage-profile/security/api-tokens),
# which stays on this server. Re-read on every request — no restart needed.
# JPD_SITE=your-site.atlassian.net
# JPD_EMAIL=you@example.com
# JPD_API_TOKEN=
# JPD_PROJECT_KEY=PI

# ── Server ────────────────────────────────────────────────────────────────────
# Optional: repo root for agent cwd (defaults to monorepo root)
# DS_REPO_ROOT=

# Optional: agent server port (default 8787)
# AGENT_SERVER_PORT=8787
