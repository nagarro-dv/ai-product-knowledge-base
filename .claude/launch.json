{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ds-starter-kit-agent",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:agent"
      ],
      "port": 8787
    },
    {
      "name": "ds-starter-kit-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:web"
      ],
      "port": 5173
    },
    {
      "name": "ds-starter-kit-storybook",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "storybook",
        "-w",
        "@ds-starter/web"
      ],
      "port": 6006
    }
  ]
}
